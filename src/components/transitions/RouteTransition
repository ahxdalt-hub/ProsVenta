"use client";

import { createContext, useCallback, useContext, useRef, useState } from "react";
import { useRouter } from "next/navigation";
import { useReducedMotion } from "framer-motion";
import { NavigationProgress } from "./NavigationProgress";
import { useWorkspaceLoading } from "@/components/loading/WorkspaceLoadingProvider";
import { useAuthLoading } from "@/components/loading/AuthLoadingProvider";
import { useAuthState } from "@/components/loading/useAuthState";
import {
  getLoadingMessages,
  isAuthRoute,
  AUTH_NAV_MESSAGES,
} from "@/components/loading/loading-messages";

interface RouteTransitionContextValue {
  navigate: (href: string) => void;
  isTransitioning: boolean;
}

const RouteTransitionContext = createContext<RouteTransitionContextValue>({
  navigate: () => {},
  isTransitioning: false,
});

export function useRouteTransition() {
  return useContext(RouteTransitionContext);
}

/**
 * Client-side navigation with a fullscreen loading overlay.
 *
 * Navigation is issued immediately; the overlay covers any in-progress render.
 *
 * Overlay selection (automatic, based on auth state + destination route):
 *  - Unauthenticated → auth route     : AuthLoadingOverlay (auth messages)
 *  - Authenticated   → dashboard route : dashboard LoadingOverlay (route msgs)
 *
 * The destination page's WorkspaceContent (dashboard) or AuthContent (auth)
 * signals readiness, letting the overlay fade out and reveal the
 * already-rendered page — no flash, no secondary loading.
 */

const NAV_MIN_DURATION = 450;
const AUTH_NAV_MIN_DURATION = 1200;

export function RouteTransitionProvider({
  children,
}: {
  children: React.ReactNode;
}) {
  const router = useRouter();
  const reduce = useReducedMotion();
  const { showOverlay } = useWorkspaceLoading();
  const { showAuthOverlay } = useAuthLoading();
  const authState = useAuthState();
  const [isTransitioning, setIsTransitioning] = useState(false);
  const pendingHref = useRef<string | null>(null);

  const navigate = useCallback(
    (href: string) => {
      if (reduce) {
        router.push(href);
        return;
      }

      if (isTransitioning) return;

      pendingHref.current = href;
      setIsTransitioning(true);

      // Navigate immediately — the overlay masks the transition.
      router.push(href);

      // Choose the correct overlay based on auth state + destination route.
      //
      // - Unauthenticated user navigating to an auth route (signup / login /
      //   forgot-password) → show the dedicated AuthLoadingOverlay with
      //   authentication messages. Do NOT show the dashboard loading overlay.
      //
      // - Authenticated user navigating to a dashboard route (or any other
      //   route) → show the dashboard LoadingOverlay with route-specific
      //   messages. This preserves the existing dashboard transition.
      //
      // Note: authenticated users hitting auth routes are redirected to
      // /dashboard by the server layout, so the dashboard overlay is correct.
      const useAuthOverlay =
        isAuthRoute(href) && authState === "unauthenticated";

      if (useAuthOverlay) {
        showAuthOverlay({
          minDuration: AUTH_NAV_MIN_DURATION,
          messages: AUTH_NAV_MESSAGES,
          fallbackMs: 3500,
        });
      } else {
        showOverlay({
          minDuration: NAV_MIN_DURATION,
          messages: getLoadingMessages(href),
          fallbackMs: 3500,
        });
      }

      // Keep the top progress bar in sync for the navigation lifecycle.
      // It completes when the overlay fades (i.e. the page is ready).
      // We extend it just slightly past the overlay to avoid a gap.
      const minDuration = useAuthOverlay
        ? AUTH_NAV_MIN_DURATION
        : NAV_MIN_DURATION;
      setTimeout(() => {
        setIsTransitioning(false);
        pendingHref.current = null;
      }, minDuration + 300);
    },
    [router, isTransitioning, reduce, showOverlay, showAuthOverlay, authState]
  );

  return (
    <RouteTransitionContext.Provider value={{ navigate, isTransitioning }}>
      {children}

      <NavigationProgress active={isTransitioning} />
    </RouteTransitionContext.Provider>
  );
}