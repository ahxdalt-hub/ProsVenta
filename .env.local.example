# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ============================================================================
# Sales Intelligence Provider Configuration (SERVER-ONLY)
# ----------------------------------------------------------------------------
# These variables are read server-side only. NEVER prefix with NEXT_PUBLIC_.
# All providers are optional in this phase - no key is required to run.
# ============================================================================

# Active provider ids (leave empty to use built-in defaults)
# INTELLIGENCE_COMPANY_PROVIDER=
# INTELLIGENCE_PROSPECT_PROVIDER=
# COMPANY_RESEARCH_PROVIDER=grounded-v1

# Provider API keys - server-side only, never exposed to the browser
# INTELLIGENCE_COMPANY_API_KEY=
# INTELLIGENCE_PROSPECT_API_KEY=
# INTELLIGENCE_AI_API_KEY=

# Provider timeout in milliseconds (default: 15000)
# INTELLIGENCE_PROVIDER_TIMEOUT_MS=15000

# Development-only mock provider (NEVER enable in production)
# Set to "true" only in local development to test the UI without API credits.
# INTELLIGENCE_ENABLE_MOCK=false

# ============================================================================
# Payment Provider Configuration (SERVER-ONLY) — Stage 8
# ----------------------------------------------------------------------------
# NEVER prefix these with NEXT_PUBLIC_. Never log secret values. The Stripe
# provider stays disabled until PAYMENT_PROVIDER is set; without configuration
# checkout returns 503 PAYMENT_PROVIDER_NOT_CONFIGURED (honest, safe default).
# ============================================================================

# Active provider id: "stripe" | "none" (empty/absent = disabled)
PAYMENT_PROVIDER=

# Stripe secret key (server-side only). Use TEST keys for dev/test
# environments and LIVE keys ONLY in production.
STRIPE_SECRET_KEY=sk_test_xxx

# Webhook signing secret for the /api/payments/webhook endpoint
# (Stripe Dashboard → Developers → Webhooks → signing secret).
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Publishable key is NOT required by this implementation: the client never
# talks to Stripe directly — checkout sessions are created server-side and the
# browser only follows the returned redirect URL.

# ============================================================================
# Database maintenance scripts (scripts/*.py, SERVER-ONLY)
# ----------------------------------------------------------------------------
# Required by scripts/db_helper.py and apply_migration.py. Never commit the
# real value. Prefer a scoped/scalable pooler user where possible.
# ============================================================================
SUPABASE_DB_PASSWORD=


# Lead discovery provider (SERVER-SIDE ONLY � never NEXT_PUBLIC_)
# Apollo.io-compatible people search API key used by Find Matching Leads.
LEAD_PROVIDER_APOLLO_API_KEY=

# ============================================================================
# Signal Detection (Feature 3 - Phase 2, SERVER-ONLY)
# ----------------------------------------------------------------------------
# Real hiring-signal detection uses PUBLIC job-board APIs (no keys required).
# A board slug is used ONLY when explicitly mapped to a domain here - slugs
# are never guessed. Format: "domain=slug" pairs, comma separated.
# Leadership/funding/job-change signals require a signal provider (via
# organization_provider_configs or SIGNALS_PROVIDER) - they stay honestly
# unavailable until one is configured.
# ============================================================================
# SIGNALS_GREENHOUSE_BOARDS=acme.com=acme
# SIGNALS_LEVER_BOARDS=acme.com=acme
# SIGNALS_PROVIDER=

# ============================================================================
# Intelligence Reasoning Model (Feature 4 - Phase 2, SERVER-ONLY)
# ----------------------------------------------------------------------------
# Optional. When PROSVENTA_REASONING_API_KEY is set, the Intelligence engine
# adds AI interpretation (explanations, key factors, concerns) on top of the
# deterministic analysis. Without it, Intelligence still works using the
# deterministic engine only — nothing is invented.
# Works with any OpenAI chat-completions-compatible endpoint.
# ============================================================================
PROSVENTA_REASONING_API_KEY=
# PROSVENTA_REASONING_BASE_URL=https://api.openai.com/v1
# PROSVENTA_REASONING_MODEL=gpt-4o-mini
