# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ============================================================================
# Sales Intelligence Provider Configuration (SERVER-ONLY)
# ----------------------------------------------------------------------------
# These variables are read server-side only. NEVER prefix with NEXT_PUBLIC_.
# All providers are optional in this phase - no key is required to run.
# ============================================================================

# Active provider ids (leave empty to use built-in defaults)
# INTELLIGENCE_COMPANY_PROVIDER=
# INTELLIGENCE_PROSPECT_PROVIDER=
# COMPANY_RESEARCH_PROVIDER=grounded-v1

# Provider API keys - server-side only, never exposed to the browser
# INTELLIGENCE_COMPANY_API_KEY=
# INTELLIGENCE_PROSPECT_API_KEY=
# INTELLIGENCE_AI_API_KEY=

# Provider timeout in milliseconds (default: 15000)
# INTELLIGENCE_PROVIDER_TIMEOUT_MS=15000

# Development-only mock provider (NEVER enable in production)
# Set to "true" only in local development to test the UI without API credits.
# INTELLIGENCE_ENABLE_MOCK=false
